[Unit]
Description=beacond heartbeat daemon
Documentation=https://github.com/example/beacond
After=network.target

[Service]
Type=simple
User=beacon
Group=beacon
ExecStart=/usr/bin/beacond -config /etc/beacond/beacond.yaml
Restart=on-failure
RestartSec=5
LimitNOFILE=4096

# Security hardening. beacond binds one loopback TCP port (no
# CAP_NET_BIND_SERVICE needed -- see README.md "Runtime expectations") and
# its only filesystem write is /var/log/beacond; every directive below was
# checked against what cmd/beacond/main.go actually does before being added.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/log/beacond
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
